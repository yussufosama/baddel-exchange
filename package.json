{
  "name": "baddel-exchange",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "start": "node scripts/start.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:setup": "prisma migrate deploy && tsx scripts/seed.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "tsx scripts/worker.ts",
    "backup": "tsx scripts/backup.ts",
    "setup": "node scripts/setup.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "format": "prettier --write app scripts tests e2e *.ts *.json",
    "format:check": "prettier --check app scripts tests e2e *.ts *.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "isbot": "^5",
    "lucide-react": "^0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.18.4",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.9",
    "prisma": "6.19.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
